<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditorActivity">


    <com.expressapps.presentexpress.helper.BaseStatusBar
        android:id="@+id/base_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorLight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/base_status_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="@string/photo_editor"
            app:navigationIcon="@drawable/icon_back_24"
            app:titleTextColor="@color/colorText"
            app:navigationIconTint="@color/colorText"
            app:navigationContentDescription="@string/back" />

    </com.google.android.material.appbar.AppBarLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/base_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorBackground"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:id="@+id/previewlayout"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:background="@color/colorMedium"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="15dp">

                <ImageView
                    android:id="@+id/previewimg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_loading_wide"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="H,16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:importantForAccessibility="no" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


        <ScrollView
            android:id="@+id/scroller"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/colorBackground"
            android:orientation="vertical"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previewlayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="20dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    style="@style/SettingsCheckBox"
                    android:text="@string/show_picture_preview"
                    android:onClick="onShowPreviewClick"
                    android:checked="true" />

                <View
                    android:layout_marginVertical="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginHorizontal="25dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="25dp"
                    android:paddingVertical="10dp"
                    android:labelFor="@+id/filter_group"
                    android:text="@string/filters"
                    android:textColor="@color/colorText"
                    android:textSize="16sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorBackground"
                    android:paddingHorizontal="25dp"
                    android:clipToPadding="false"
                    android:fillViewport="true">

                    <com.google.android.material.button.MaterialButtonGroup
                        android:id="@+id/filter_group"
                        style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/greyscalefilter"
                            android:text="@string/greyscale"
                            android:onClick="onFilterButtonClick"
                            android:checkable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sepiafilter"
                            android:text="@string/sepia"
                            android:onClick="onFilterButtonClick"
                            android:checkable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/blackwhitefilter"
                            android:text="@string/black_white"
                            android:onClick="onFilterButtonClick"
                            android:checkable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/redfilter"
                            android:text="@string/red_tint"
                            android:onClick="onFilterButtonClick"
                            android:checkable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/greenfilter"
                            android:text="@string/green_tint"
                            android:onClick="onFilterButtonClick"
                            android:checkable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bluefilter"
                            android:text="@string/blue_tint"
                            android:onClick="onFilterButtonClick"
                            android:checkable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </com.google.android.material.button.MaterialButtonGroup>

                </HorizontalScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="25dp"
                    android:labelFor="@+id/brightness"
                    android:paddingTop="20dp"
                    android:text="@string/brightness"
                    android:textColor="@color/colorText"
                    android:textSize="16sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="-100"
                    android:valueTo="100"
                    app:tickVisible="false"
                    android:layout_marginHorizontal="15dp"
                    app:trackColorInactive="@color/colorLight" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="25dp"
                    android:paddingTop="15dp"
                    android:labelFor="@+id/contrast"
                    android:text="@string/contrast"
                    android:textColor="@color/colorText"
                    android:textSize="16sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/contrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="-100"
                    android:valueTo="100"
                    app:tickVisible="false"
                    android:layout_marginHorizontal="15dp"
                    app:trackColorInactive="@color/colorLight" />

                <View
                    android:layout_marginVertical="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginHorizontal="25dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/SettingsButton"
                    android:onClick="onRotateRightClick"
                    android:text="@string/rotate_clockwise"
                    app:icon="@drawable/icon_rotate_right_24" />

                <com.google.android.material.button.MaterialButton
                    style="@style/SettingsButton"
                    android:onClick="onRotateLeftClick"
                    android:text="@string/rotate_anticlockwise"
                    app:icon="@drawable/icon_rotate_left_24" />

                <View
                    android:layout_marginVertical="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginHorizontal="25dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    style="@style/SettingsCheckBox"
                    android:id="@+id/fliphorizontal"
                    android:text="@string/flip_horizontal"
                    android:onClick="onFlipHorizontalClick" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    style="@style/SettingsCheckBox"
                    android:id="@+id/flipvertical"
                    android:text="@string/flip_vertical"
                    android:onClick="onFlipVerticalClick" />

                <View
                    android:layout_marginVertical="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginHorizontal="25dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/SettingsButton"
                    android:onClick="onResetClick"
                    android:text="@string/reset_all"
                    app:icon="@drawable/icon_delete_24" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:onClick="onFabClick"
        app:icon="@drawable/icon_check_24"
        android:text="@string/done"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>