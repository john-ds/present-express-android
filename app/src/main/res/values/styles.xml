<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorDark</item>
        <item name="colorAccent">@color/colorDark</item>
        <item name="colorPrimaryDark">@color/colorDark</item>
        <item name="colorSurfaceContainer">@color/colorLight</item>
        <item name="colorPrimaryContainer">@color/colorDark</item>
        <item name="colorOnPrimaryContainer">@color/colorBackground</item>
        <item name="colorSurface">@color/colorLight</item>
        <item name="colorOnSurface">@color/colorDark</item>
        <item name="colorOnPrimary">@color/colorBackground</item>
        <item name="colorSurfaceContainerHigh">@color/colorBackground</item>
        <item name="android:textColorHighlight">@color/colorMedium</item>

        <item name="android:windowLightStatusBar">@bool/light_navigation_bars</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/colorLight
        </item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/colorLight</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">
            @bool/light_navigation_bars
        </item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="listPreferredItemHeightSmall">56dp</item>
        <item name="fontFamily">@font/inter</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Launcher">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>

    <style name="FullscreenTheme" parent="AppTheme.Launcher">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="SettingsButton" parent="Widget.Material3Expressive.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:backgroundTint">@color/colorBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">16sp</item>
        <item name="iconPadding">15dp</item>
        <item name="iconSize">30dp</item>
        <item name="iconTint">@color/colorDark</item>
        <item name="rippleColor">@color/colorMedium</item>
    </style>

    <style name="SettingsCheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:backgroundTint">@color/colorBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">16sp</item>
        <item name="iconPadding">15dp</item>
        <item name="iconSize">30dp</item>
        <item name="buttonTint">@color/colorDark</item>
        <item name="buttonIconTint">@color/colorBackground</item>
        <item name="rippleColor">@color/colorMedium</item>
    </style>

    <style name="ToolbarButton" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="rippleColor">@color/colorMedium</item>
        <item name="iconTint">@color/colorDark</item>
    </style>

</resources>